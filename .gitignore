# ScholarChain .gitignore. Owner: build-engineer.

# sbt and Scala build output
target/
project/target/
project/project/target/
project/project/project/
.bsp/
.bloop/
.metals/
metals.sbt
*.class
*.tasty
*.log

# IDEs and OS files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Generated by `sbt check` (markTestRun); never committed, never written by hand
.claude/.last-test-run
# Human-local Claude Code settings; uncommitted by policy (docs/agents.md section 4)
.claude/settings.local.json

# Secret material is never committed. Local placeholders are committed *.example files instead.
.env
.env.*
.envrc
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
.credentials.json

# Terraform local state and caches (the dependency lock file .terraform.lock.hcl is committed).
# *.tfvars holds local values (for example the budget alert email) and is never committed;
# only *.tfvars.example files with dummy values are committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
# Backend configuration holds the real state bucket name (which contains the account ID); only
# backend.hcl.example is committed. .terraform.lock.hcl is not matched and stays committed.
backend.hcl
*.backend.hcl
# Per-machine override files (standard HashiCorp entries); *.example templates are not matched.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Python tooling caches (dataset and helper scripts)
__pycache__/
*.pyc
.venv/
