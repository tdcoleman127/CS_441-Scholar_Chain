# ScholarChain .gitignore. Owner: build-engineer.

# sbt and Scala build output
target/
project/target/
project/project/target/
project/project/project/
.bsp/
.bloop/
.metals/
metals.sbt
*.class
*.tasty
*.log

# IDEs and OS files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Generated by `sbt check` (markTestRun); never committed, never written by hand
.claude/.last-test-run
# Human-local Claude Code settings; uncommitted by policy (docs/agents.md section 4)
.claude/settings.local.json

# Secret material is never committed. Local placeholders are committed *.example files instead.
.env
.env.*
.envrc
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
.credentials.json

# Terraform local state and caches (the dependency lock file .terraform.lock.hcl is committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Python tooling caches (dataset and helper scripts)
__pycache__/
*.pyc
.venv/
