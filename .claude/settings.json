  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dangerous.sh\"; [ -f \"$h\" ] || { echo 'BLOCKED: .claude/hooks/guard-dangerous.sh is missing, so commands cannot be checked (fail closed). Ask the human to restore it from git and restart Claude Code.' >&2; exit 2; }; bash \"$h\" || exit 2", "timeout": 20 }
        ]
      },
      {
        "matcher": "mcp__aws-api__call_aws",
        "hooks": [
          { "type": "command", "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dangerous.sh\"; [ -f \"$h\" ] || { echo 'BLOCKED: .claude/hooks/guard-dangerous.sh is missing, so AWS calls cannot be checked (fail closed). Ask the human to restore it from git and restart Claude Code.' >&2; exit 2; }; bash \"$h\" || exit 2", "timeout": 20 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-ownership.sh\"; [ -f \"$h\" ] || { echo 'BLOCKED: .claude/hooks/guard-ownership.sh is missing, so writes cannot be checked (fail closed). Ask the human to restore it from git and restart Claude Code.' >&2; exit 2; }; bash \"$h\" || exit 2", "timeout": 20 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-scala.sh\"", "timeout": 120 },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-agent-files.sh\" --hook", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-tests-ran.sh\"; [ -f \"$h\" ] && exec bash \"$h\"; grep -Eq '\"stop_hook_active\"[[:space:]]*:[[:space:]]*true' && exit 0; echo 'BLOCKED: .claude/hooks/verify-tests-ran.sh is missing, so the test-stop gate cannot run (fail closed). Report this and ask the human to restore it from git.' >&2; exit 2", "timeout": 30 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "h=\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-tests-ran.sh\"; [ -f \"$h\" ] && exec bash \"$h\"; grep -Eq '\"stop_hook_active\"[[:space:]]*:[[:space:]]*true' && exit 0; echo 'BLOCKED: .claude/hooks/verify-tests-ran.sh is missing, so the test-stop gate cannot run (fail closed). Report this and ask the human to restore it from git.' >&2; exit 2", "timeout": 30 }
        ]
      }
    ]
