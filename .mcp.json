{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${SCHOLARCHAIN_GITHUB_READONLY_PAT}",
        "X-MCP-Readonly": "true"
      }
    },
    "aws-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.7.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile", "${SCHOLARCHAIN_AWS_READONLY_PROFILE:-scholarchain-readonly}",
        "--read-only",
        "--metadata", "AWS_REGION=${AWS_REGION:-us-east-1}",
        "--disable-telemetry"
      ],
      "env": {
        "AWS_PROFILE": "${SCHOLARCHAIN_AWS_READONLY_PROFILE:-scholarchain-readonly}",
        "AWS_REGION": "${AWS_REGION:-us-east-1}"
      }
    },
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "ENABLE_TF_OPERATIONS=false",
        "hashicorp/terraform-mcp-server:1.3.0",
        "--toolsets=registry"
      ]
    },
    "aws-docs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@1.2.2"],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
