{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${SCHOLARCHAIN_GITHUB_READONLY_PAT}",
        "X-MCP-Readonly": "true"
      }
    },
    "aws-api": {
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@1.5.6"],
      "env": {
        "AWS_API_MCP_PROFILE_NAME": "${SCHOLARCHAIN_AWS_READONLY_PROFILE:-scholarchain-readonly}",
        "AWS_REGION": "${AWS_REGION:-us-east-1}",
        "READ_OPERATIONS_ONLY": "true",
        "REQUIRE_MUTATION_CONSENT": "true",
        "AWS_API_MCP_ALLOW_UNRESTRICTED_LOCAL_FILE_ACCESS": "no-access",
        "AWS_API_MCP_TELEMETRY": "false"
      }
    },
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "ENABLE_TF_OPERATIONS=false",
        "hashicorp/terraform-mcp-server:1.3.0",
        "--toolsets=registry"
      ]
    },
    "aws-docs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@1.2.2"],
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
