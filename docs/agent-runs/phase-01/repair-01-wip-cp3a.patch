+        [[ "$tok" == [-+]*[sS]* ]] && IO_S=1
+        [[ "$tok" =~ ^[-+][a-zA-Z]*[oO]$ ]] && m=$((m+1))
+        m=$((m+1)) ;;
+      *) break ;;
+    esac
+  done
